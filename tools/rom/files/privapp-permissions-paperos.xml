<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged permissions PaperOS may hold as a /system/priv-app. Android refuses to boot if a
  priv-app *requests* a privileged permission that is not listed here, so this list is a superset
  of what the launcher manifest asks for.
-->
<permissions>
    <privapp-permissions package="io.paperos.launcher">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <permission name="android.permission.CHANGE_CONFIGURATION"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.DEVICE_POWER"/>
        <permission name="android.permission.REBOOT"/>
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.CONTROL_DISPLAY_BRIGHTNESS"/>
        <permission name="android.permission.READ_FRAME_BUFFER"/>
        <permission name="android.permission.OVERRIDE_WIFI_CONFIG"/>
        <permission name="android.permission.SET_TIME"/>
        <permission name="android.permission.SET_TIME_ZONE"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.NETWORK_AIRPLANE_MODE"/>
    </privapp-permissions>
</permissions>
